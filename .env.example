# Auth0 Configuration (IMPLEMENTED)
AUTH0_DOMAIN=https://your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.kronoscode.ai
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret

# Redis Configuration (IMPLEMENTED - for rate limiting and job queue)
REDIS_URL=redis://localhost:6379

# Sandbox Providers (GATED - requires feature flags)
E2B_API_KEY=your_e2b_api_key
SANDBOX_PROVIDER=e2b

# Feature Flags - CRITICAL: Core functionality is GATED
# MCP Integration (GATED - NOT YET IMPLEMENTED)
KRONOSCODE_ENABLE_REAL_MCP=false
# E2B Integration (GATED - NOT YET IMPLEMENTED) 
KRONOSCODE_ENABLE_REAL_E2B=false
# Self-hosted Integration (GATED - NOT YET IMPLEMENTED)
KRONOSCODE_ENABLE_REAL_SELF_HOSTED=false

# Marketplace Configuration (IMPLEMENTED)
MARKETPLACE_REGISTRY_URL=https://registry.kronoscode.ai
MARKETPLACE_CACHE_TTL=300

# Rate Limiting (IMPLEMENTED)
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_USER_MAX=500
RATE_LIMIT_ORG_MAX=50
RATE_LIMIT_INSTALL_MAX=5
RATE_LIMIT_SESSION_MAX=10

# Job Queue Configuration (IMPLEMENTED)
QUEUE_REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=10
QUEUE_MAX_RETRIES=3

# Health Check Configuration (IMPLEMENTED)
HEALTH_CHECK_INTERVAL=300000
HEALTH_CHECK_TIMEOUT=30000

# Session Configuration (IMPLEMENTED)
SESSION_HEARTBEAT_TIMEOUT=300000
SESSION_TAKEOVER_TIMEOUT=300000
SESSION_CLEANUP_INTERVAL=3600000

# Logging (IMPLEMENTED)
LOG_LEVEL=info
LOG_FORMAT=json

# Database (IMPLEMENTED - SQLite only, NOT horizontally scalable)
# WARNING: Current implementation uses SQLite and is NOT horizontally scalable
DATABASE_URL=file:./kronoscode.db
